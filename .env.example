# Copy to .env on the server. Never commit a real .env file.

# 32 random bytes, base64. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILCONNECT_MASTER_KEY=replace-with-base64-32-bytes

# At least 32 characters. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

HOST=127.0.0.1
PORT=3911
NODE_ENV=production
APP_BASE_PATH=/mailconnect
APP_BASE_URL=https://sinthex.de/mailconnect
DATABASE_PATH=./var/mailconnect.sqlite
WEB_DIST=./public
INDEX_POLL_MS=120000
INDEX_BATCH=80

# Used only by: node dist/server.cjs bootstrap-admin
# MAILCONNECT_ADMIN_EMAIL=you@example.com
# MAILCONNECT_ADMIN_PASSWORD=replace-with-a-long-password
