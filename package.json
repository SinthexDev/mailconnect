{
  "name": "mailconnect",
  "private": true,
  "version": "1.1.43",
  "type": "module",
  "description": "Self-hosted mail account vault with IMAP/SMTP indexing and an MCP interface.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w @mailconnect/api\" \"npm run dev -w @mailconnect/web\"",
    "build": "npm run build -w @mailconnect/web && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test packages/domain/src/*.test.ts packages/adapters/src/*.test.ts",
    "start": "node dist/server.cjs",
    "bootstrap-admin": "node dist/server.cjs bootstrap-admin"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.44.0": true,
    "better-sqlite3-multiple-ciphers@13.0.3": true
  }
}
