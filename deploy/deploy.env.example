# Copy to deploy/deploy.env and fill in your own server. deploy/deploy.env is ignored by git.
# scripts/deploy.sh reads this file. Nothing here is a secret; the secrets live in .env on the server.

# SSH host or alias from ~/.ssh/config.
DEPLOY_SSH_HOST=example-server

# Directory on the server, outside the document root. Holds app/, var/ and .env.
DEPLOY_REMOTE_ROOT=/srv/mailconnect

# Optional: document-root directory for the PHP forwarder in deploy/public.
# Leave empty when a reverse proxy (deploy/*.conf.example) talks to the Node process directly.
DEPLOY_PUBLIC_ROOT=

# Directory that contains the node binary on the server.
DEPLOY_NODE_BIN=/usr/bin

# Public address and path of this installation.
DEPLOY_APP_BASE_PATH=/mailconnect
DEPLOY_APP_BASE_URL=https://example.com/mailconnect
DEPLOY_PORT=3911

# Used once to create the first admin. The password is generated on the server.
DEPLOY_ADMIN_EMAIL=you@example.com
